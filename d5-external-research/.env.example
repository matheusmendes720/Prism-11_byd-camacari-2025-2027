# D5 External Research — API keys (copy to .env, fill what you have)
# LIVE for what's set; DRY-RUN automatic for what's missing.
# Parent case-study: byd-camacari-2025-2027 (wave ONDA 2026-07)

# ───────────────────────────────────────────────────────────
# dexter (Bun + TypeScript) — REQUIRED for LIVE OSINT/DPR
# ───────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...                          # LLM for dexter agents + FinRobot 8-agents
FINANCIAL_DATASETS_API_KEY=                    # dexter tools: get_financials, read_filings, stock_screener
EXASEARCH_API_KEY=                             # web_search (preferred); fallback: PERPLEXITY/TAVILY/LANGSEARCH
TAVILY_API_KEY=tvly-...                        # alternate search provider
PERPLEXITY_API_KEY=                            # alternate
LANGSEARCH_API_KEY=                            # alternate (lowest priority)
X_BEARER_TOKEN=                                # optional, for x-research skill

# ───────────────────────────────────────────────────────────
# OpenBB (Python + poetry) — REQUIRED for Brasil macro
# ───────────────────────────────────────────────────────────
FRED_API_KEY=                                  # Federal Reserve Economic Data; free at fred.stlouisfed.org

# ───────────────────────────────────────────────────────────
# FinRobot (Python) — REQUIRED for equity pipeline LIVE
# ───────────────────────────────────────────────────────────
# Configured in FinRobot/finrobot_equity/core/config/config.ini (not .env):
#   [API_KEYS]
#   fmp_api_key = ...        # Financial Modeling Prep — equity fundamentals
#   openai_api_key = ...     # 8 equity-research agents (tagline, overview, etc.)
#   openai_base_url = ...    # optional proxy (SiliconFlow, MiniMax, etc.)
#   openai_model = gpt-4.1   # default; can swap for cheaper model
#   adanos_api_key = ...     # optional retail sentiment via Adanos Finance API